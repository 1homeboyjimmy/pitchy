# Настройка для Grafana (Мониторинг)
grafana.pitchy.pro {
    reverse_proxy grafana:3000
}

# Основной сайт Pitchy.pro и Dev-стенд
pitchy.pro, dev.pitchy.pro {
    # Ограничение доступа к метрикам (только для локальных запросов)
    handle /metrics {
        @external not remote_ip private_ranges 127.0.0.1/8 ::1
        respond @external 403
        reverse_proxy backend:8000
    }

    # API - Маршруты для бэкенда (Python/FastAPI)
    @api {
        path /auth* /analysis* /chat* /admin* /health /dev/emails /analyze-startup /me /tree* /api/*
        not path /api/graph/*
    }
    handle @api {
        # Rate limiting (requires caddy-ratelimit plugin)
        # rate_limit {
        #     zone api {
        #         key {remote_ip}
        #         events 100
        #         window 1m
        #     }
        # }
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_ip}
            header_up X-Forwarded-For {remote_ip}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Accel-Buffering no
            flush_interval -1
            transport http {
                # Увеличиваем таймаут для генерации ответов ИИ и тяжелой обработки PDF (до 10 минут)
                read_timeout 600s
            }
        }
    }

    # Настройки безопасности и заголовков
    header {
        # HSTS (заставляет браузер всегда использовать HTTPS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Защита от кликджекинга
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"

        # Content Security Policy (Исправлено для работы /account и WebSocket)
        # Разрешаем подключения к своим поддоменам и внешним API (например, HuggingFace/OpenAI)
        Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; media-src 'self' blob: https://stream.mux.com https: data:; worker-src 'self' blob:; connect-src 'self' https://stream.mux.com https: wss: pitchy.pro *.pitchy.pro;"
    }

    # Сжатие контента для ускорения загрузки (исключая SSE для предотвращения буферизации)
    @not-sse {
        not header Content-Type *text/event-stream*
    }
    encode @not-sse gzip zstd

    # Все остальные запросы направляем на Frontend (Next.js)
    handle {
        reverse_proxy frontend:3000 {
            # Передача реального IP пользователя (важно для логов и аналитики)
            header_up Host {host}
            header_up X-Real-IP {remote_ip}
            header_up X-Forwarded-For {remote_ip}
            header_up X-Forwarded-Proto {scheme}

            # Поддержка WebSocket (Критично для Next.js dev mode и HMR)
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }
}